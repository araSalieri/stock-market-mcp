# Copy to .env next to compose.yaml; compose reads it automatically.

# Required for get_signal. Get a key at https://openrouter.ai/keys
SMM_OPENROUTER_API_KEY=

# Required for get_sentiment. Get a key at https://console.x.ai
# X Search costs $5 per 1k posts fetched plus Grok tokens.
SMM_XAI_API_KEY=

# Optional. Classifier model id; defaults to typesafe/jev-1.13
SMM_CLASSIFIER_MODEL=

# Optional. DEBUG, INFO, WARNING or ERROR; defaults to INFO
SMM_LOG_LEVEL=
